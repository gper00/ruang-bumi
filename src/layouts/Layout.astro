---
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep the title verbatim (used by the home page). */
  fullTitle?: boolean;
}

const {
  title = 'Ruang Bumi',
  description = 'Situs belajar ilmu kebumian berbahasa Indonesia, dengan visual interaktif dan sumber yang transparan.',
  fullTitle = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} · Ruang Bumi`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ruangbumi.example');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link
      rel="preload"
      href="/fonts/figtree-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (!saved) {
            saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', saved);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg">
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <Header />
    <main id="konten" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--sea);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .skip-link:focus {
    top: 12px;
  }
</style>
