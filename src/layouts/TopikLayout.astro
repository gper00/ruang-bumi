---
import Layout from './Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import AnswerBox from '../components/topik/AnswerBox.astro';
import RelatedTopics from '../components/topik/RelatedTopics.astro';
import SourceList from '../components/topik/SourceList.astro';
import { kategoriLabel, tanggalIndo, type Topik } from '../lib/topik';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: Topik;
  headings?: Heading[];
}

const { entry, headings = [] } = Astro.props;

// Daftar isi dibangun dari heading artikel, ditambah dua tujuan tetap di kaki halaman.
const toc = [
  ...headings
    .filter((h) => h.depth === 2 || h.depth === 3)
    .map((h) => ({ id: h.slug, teks: h.text, level: h.depth })),
  { id: 'quiz-judul', teks: 'Kuis', level: 2 },
  { id: 'sumber', teks: 'Sumber', level: 2 },
];
---

<Layout title={entry.data.pertanyaan} description={entry.data.jawabanSingkat}>
  <div class="wrap topik-wrap">
    <Breadcrumb
      items={[
        { href: '/', label: 'Beranda' },
        { href: `/kategori/${entry.data.kategori}/`, label: kategoriLabel(entry.data.kategori) },
        { label: entry.data.pertanyaan },
      ]}
    />

    <div class="topik-grid">
      <article class="topik-utama" data-kategori={entry.data.kategori}>
        <header class="topik-head">
          <p class="head-kicker">
            <span class="kicker-aksen">{kategoriLabel(entry.data.kategori)}</span>
            <span class="kicker-level">{entry.data.level}</span>
          </p>
          <h1>{entry.data.pertanyaan}</h1>
          <p class="meta">
            <span>{entry.data.menit} menit baca</span>
            <span>Diverifikasi {tanggalIndo(entry.data.diverifikasi)}</span>
            <span>{entry.data.penulis}</span>
          </p>
        </header>

        <AnswerBox ringkas={entry.data.jawabanSingkat} />

        {
          toc.length > 2 && (
            <details class="toc-ringkas">
              <summary>
                Di halaman ini <span>{toc.length} bagian</span>
              </summary>
              <ol>
                {toc.map((item) => (
                  <li class={item.level === 3 ? 'toc-sub' : undefined}>
                    <a href={`#${item.id}`}>{item.teks}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="prose">
          <slot />
        </div>

        <SourceList entry={entry} />
      </article>

      <aside class="topik-sisi" aria-label="Informasi tambahan topik">
        {
          toc.length > 2 && (
            <nav class="sisi-blok toc" aria-labelledby="toc-judul" id="toc">
              <h2 class="label" id="toc-judul">
                Di halaman ini
              </h2>
              <ol>
                {toc.map((item) => (
                  <li class={item.level === 3 ? 'toc-sub' : undefined}>
                    <a href={`#${item.id}`} data-toc={item.id}>
                      {item.teks}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <RelatedTopics entry={entry} />

        <section class="sisi-blok">
          <h2 class="label">Cara membaca halaman ini</h2>
          <p>
            Angka dan klaim penting diberi penanda{' '}
            <a href="#sumber">[n]</a> yang menunjuk ke daftar sumber di bawah. Visual yang
            disederhanakan diberi label ilustrasi.
          </p>
        </section>
      </aside>
    </div>

    <nav class="topik-nav" aria-label="Navigasi topik">
      <a href="/topik/">← Semua topik</a>
      <a href="/">Beranda</a>
    </nav>
  </div>
</Layout>

<script>
  // Scroll-spy: tandai tautan TOC yang mengarah ke bagian yang sedang terbaca.
  const tautan = Array.from(document.querySelectorAll<HTMLAnchorElement>('#toc a[data-toc]'));
  if (tautan.length > 0) {
    const target: Array<[string, HTMLElement]> = [];
    for (const a of tautan) {
      const id = a.dataset.toc;
      const el = id ? document.getElementById(id) : null;
      if (id && el) target.push([id, el]);
    }

    let aktif = '';
    function perbarui() {
      // Bagian yang dianggap aktif: yang paling akhir melewati 1/3 atas layar.
      let kini = '';
      for (const [id, el] of target) {
        if (el.getBoundingClientRect().top <= window.innerHeight * 0.33) kini = id;
      }
      if (kini === aktif) return;
      aktif = kini;
      for (const a of tautan) {
        if (a.dataset.toc === aktif) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    }

    perbarui();
    window.addEventListener('scroll', perbarui, { passive: true });
    window.addEventListener('resize', perbarui);
  }
</script>

<style>
  .topik-wrap {
    padding-block: 24px 48px;
  }

  .topik-grid {
    display: grid;
    gap: 36px;
    margin-top: 20px;
  }

  .topik-utama {
    min-width: 0;
  }

  @media (min-width: 960px) {
    .topik-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 56px;
      align-items: start;
    }

    .topik-sisi {
      position: sticky;
      top: 92px;
    }
  }

  /* TOC ringkas hanya untuk layar sempit; sidebar TOC mengambil alih di desktop. */
  .toc-ringkas {
    margin: 0 0 2.2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .toc-ringkas summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }

  .toc-ringkas summary::-webkit-details-marker {
    display: none;
  }

  .toc-ringkas summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .toc-ringkas[open] summary::after {
    content: '−';
  }

  .toc-ringkas summary span {
    margin-left: 2px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
  }

  .toc-ringkas ol {
    list-style: none;
    margin: 0;
    padding: 0 0 12px;
    display: grid;
    gap: 2px;
  }

  .toc-ringkas a {
    display: block;
    padding: 3px 0 3px 14px;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .toc-ringkas a:hover {
    color: var(--fg);
    border-left-color: var(--sea);
  }

  .toc-ringkas .toc-sub a {
    padding-left: 26px;
    font-size: 0.8rem;
  }

  .toc-ringkas summary:focus-visible {
    outline-offset: 4px;
  }

  @media (min-width: 960px) {
    .toc-ringkas {
      display: none;
    }
  }

  /* Header artikel */
  .topik-head {
    position: relative;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .topik-head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 64px;
    height: 3px;
    background: var(--aksen, var(--sea));
  }

  .head-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .kicker-aksen {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .kicker-aksen::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--aksen, var(--sea));
  }

  .kicker-level {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  .topik-head h1 {
    font-size: clamp(1.95rem, 4.3vw, 3rem);
    font-weight: 800;
    margin: 14px 0 12px;
    max-width: 22ch;
    text-wrap: balance;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 16px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .meta span + span::before {
    content: '·';
    margin-right: 16px;
    color: var(--line-strong);
  }

  /* Sidebar */
  .topik-sisi {
    display: grid;
    gap: 28px;
    align-content: start;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 960px) {
    .topik-sisi {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 28px;
      padding-top: 0;
    }
  }

  @media (max-width: 959px) {
    .topik-sisi .toc {
      display: none;
    }
  }

  .sisi-blok p,
  .sisi-blok ol {
    margin: 8px 0 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .sisi-blok ol {
    padding-left: 1.1rem;
    display: grid;
    gap: 4px;
  }

  .sisi-blok a {
    color: var(--muted);
    text-decoration: none;
  }

  .sisi-blok a:hover {
    color: var(--sea);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* TOC */
  .toc ol {
    list-style: none;
    padding-left: 0;
    counter-reset: toc;
    border-left: 1px solid var(--line);
    margin-top: 8px;
  }

  .toc li {
    margin-top: 0;
  }

  .toc a {
    display: block;
    padding: 5px 0 5px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .toc .toc-sub a {
    padding-left: 24px;
    font-size: 0.8rem;
  }

  .toc a:hover {
    color: var(--fg);
  }

  .toc a[aria-current='location'] {
    color: var(--sea);
    border-left-color: var(--sea);
    font-weight: 600;
  }

  /* Navigasi bawah */
  .topik-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.82rem;
  }

  .topik-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .topik-nav a:hover {
    color: var(--sea);
  }
</style>
