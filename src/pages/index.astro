---
import Layout from '../layouts/Layout.astro';
import TopicCard from '../components/topik/TopicCard.astro';
import { KATEGORI, getTopikTerbit, topikHref } from '../lib/topik';

const topik = await getTopikTerbit();
const unggulan = topik[0];
const perKategori = KATEGORI.map((k) => ({
  ...k,
  jumlah: topik.filter((t) => t.data.kategori === k.id).length,
})).filter((k) => k.jumlah > 0);
const totalSumber = new Set(topik.flatMap((t) => t.data.sumber)).size;
---

<Layout title="Ruang Bumi — ilmu kebumian lewat pertanyaan" fullTitle>
  <section class="hero">
    <div class="wrap">
      <div class="meta">
        <span class="label">Lembar lapangan · ilmu kebumian</span>
        <span class="label">Inti → permukaan</span>
      </div>

      <div class="head">
        <h1>Tanya Bumi<span class="titik">.</span></h1>
        <p class="deck">
          Setiap halaman menjawab satu pertanyaan lewat visual interaktif. Setiap angka punya sumber
          yang bisa kamu buka sendiri.
        </p>
      </div>

      <nav class="strat" aria-label="Kategori, dari inti Bumi ke permukaan">
        <ol>
          {
            perKategori.map((k, i) => (
              <li data-kategori={k.id}>
                <a href={`/kategori/${k.id}/`}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="name">{k.label}</span>
                  <span class="count">
                    {String(k.jumlah).padStart(2, '0')} topik
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="foot">
        {
          unggulan && (
            <a class="start" href={topikHref(unggulan)}>
              <span class="start-label">Mulai dari</span>
              <span class="start-q">{unggulan.data.pertanyaan}</span>
              <span class="start-arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }

        <dl class="stats">
          <div>
            <dt>Topik terbit</dt>
            <dd>{topik.length}</dd>
          </div>
          <div>
            <dt>Sumber unik</dt>
            <dd>{totalSumber}</dd>
          </div>
          <div>
            <dt>Lapisan</dt>
            <dd>{String(perKategori.length).padStart(2, '0')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap daftar" aria-labelledby="daftar-judul">
    <header class="daftar-head">
      <div class="daftar-judul">
        <h2 id="daftar-judul">Indeks pertanyaan</h2>
        <p class="label">{topik.length} topik terbit · {totalSumber} sumber</p>
      </div>

      <div class="alat">
        <label class="cari">
          <span class="label">Cari topik</span>
          <span class="cari-kotak">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M10.4 10.4 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <input
              id="cari-topik"
              type="search"
              placeholder="gempa, angin, hujan…"
              autocomplete="off"
            />
          </span>
        </label>
        <div class="filter" role="group" aria-label="Filter kategori">
          <button type="button" class="chip filter-btn" data-kategori="semua" aria-pressed="true">
            Semua
          </button>
          {
            perKategori.map((k) => (
              <button type="button" class="chip filter-btn" data-kategori={k.id} aria-pressed="false">
                {k.label}
              </button>
            ))
          }
        </div>
      </div>
    </header>

    <p id="hasil-hitung" class="hasil" aria-live="polite">{topik.length} topik ditampilkan</p>

    <div class="grid-topik" id="grid-topik">
      {topik.map((entry) => <TopicCard entry={entry} />)}
    </div>

    <p id="kosong" class="kosong" hidden>
      Belum ada topik yang cocok. Coba kata kunci lain, atau pilih Semua.
    </p>

    <section class="kategori-indeks" aria-labelledby="kategori-judul">
      <header class="kategori-head">
        <h2 id="kategori-judul">Per kategori</h2>
        <p class="label">Dari inti Bumi ke permukaan</p>
      </header>
      <ul>
        {
          perKategori.map((k) => (
            <li data-kategori={k.id}>
              <a href={`/kategori/${k.id}/`}>
                <span class="kat-nama">{k.label}</span>
                <span class="kat-jumlah">
                  {k.jumlah} topik <span aria-hidden="true">→</span>
                </span>
                <span class="kat-desc">{k.deskripsi}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</Layout>

<script>
  const input = document.getElementById('cari-topik') as HTMLInputElement | null;
  const tombol = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const kartu = Array.from(document.querySelectorAll<HTMLElement>('.kartu-topik'));
  const hitung = document.getElementById('hasil-hitung');
  const kosong = document.getElementById('kosong');
  let kategori = 'semua';

  function terapkan() {
    const kata = (input?.value ?? '').toLowerCase().trim();
    let tampil = 0;
    for (const el of kartu) {
      const cocokKategori = kategori === 'semua' || el.dataset.kategori === kategori;
      const cocokKata = !kata || (el.dataset.cari ?? '').includes(kata);
      const tampilkan = cocokKategori && cocokKata;
      el.hidden = !tampilkan;
      if (tampilkan) tampil += 1;
    }
    if (hitung) hitung.textContent = `${tampil} topik ditampilkan`;
    if (kosong) kosong.hidden = tampil !== 0;
  }

  for (const b of tombol) {
    b.addEventListener('click', () => {
      kategori = b.dataset.kategori ?? 'semua';
      for (const lain of tombol) lain.setAttribute('aria-pressed', String(lain === b));
      terapkan();
    });
  }

  input?.addEventListener('input', terapkan);
</script>

<style>
  .hero {
    border-bottom: 4px solid var(--fg);
    background: var(--bg);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 18px;
    padding-block: 11px 10px;
    border-bottom: 1px solid var(--line-strong);
  }

  .meta .label {
    margin: 0;
    color: var(--fg);
  }

  .head {
    display: grid;
    gap: 16px;
    padding-block: clamp(28px, 5vw, 52px) clamp(22px, 3vw, 32px);
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 13.8vw, 11.5rem);
    font-weight: 900;
    line-height: 0.72;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .titik {
    color: var(--heat);
  }

  .deck {
    max-width: 52ch;
    margin: 0 0 0 auto;
    color: var(--muted);
    font-size: clamp(1.02rem, 1rem + 0.18vw, 1.12rem);
    font-weight: 500;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .strat {
    border-top: 2px solid var(--fg);
    border-bottom: 2px solid var(--fg);
  }

  .strat ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .strat li {
    border-left: 1px solid var(--ink);
  }

  .strat li:first-child {
    border-left: 0;
  }

  .strat a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 26px;
    min-height: 158px;
    padding: 11px 12px 13px;
    background: var(--aksen, var(--sea));
    color: var(--inti-teks);
    text-decoration: none;
    transition: box-shadow 120ms linear;
  }

  .strat a:hover {
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--inti-teks) 58%, transparent);
  }

  .num,
  .count {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-block: 24px 28px;
  }

  .start {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 16px;
    padding: 15px 18px 16px;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition:
      background-color 120ms linear,
      color 120ms linear;
  }

  .start-label {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .start-q {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.3rem;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .start-arrow {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--heat-on-ink);
    transition:
      color 120ms linear,
      transform 120ms linear;
  }

  .start:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .start:hover .start-label {
    color: var(--muted);
  }

  .start:hover .start-arrow {
    color: var(--heat-ink);
    transform: translateX(4px);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-left: 2px solid var(--fg);
  }

  .stats > div {
    padding: 4px 0 0 16px;
  }

  .stats dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stats dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 0.76;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .strat ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .strat li {
      border-top: 0;
    }

    .strat li:nth-child(3n + 1) {
      border-left: 0;
    }

    .strat li:nth-child(n + 4) {
      border-top: 1px solid var(--ink);
    }

    .strat a {
      min-height: 126px;
    }

    .foot {
      grid-template-columns: 1fr;
    }

    .stats {
      border-top: 2px solid var(--fg);
      border-left: 0;
    }

    .stats > div {
      padding: 14px 0 0;
    }

    .stats > div + div {
      padding-left: 14px;
      border-left: 1px solid var(--line-strong);
    }
  }

  @media (max-width: 520px) {
    .strat ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .strat li {
      border-top: 0;
      border-left: 1px solid var(--ink);
    }

    .strat li:nth-child(2n + 1) {
      border-left: 0;
    }

    .strat li:nth-child(n + 3) {
      border-top: 1px solid var(--ink);
    }

    .strat a {
      min-height: 112px;
    }

    .deck {
      margin-left: 0;
    }
  }

  .daftar {
    padding-block: clamp(40px, 6vw, 64px) clamp(54px, 7vw, 84px);
  }

  .daftar-head {
    display: grid;
    gap: 24px;
    align-items: end;
  }

  @media (min-width: 880px) {
    .daftar-head {
      grid-template-columns: 1fr auto;
      gap: 40px;
    }
  }

  .daftar-judul h2 {
    margin: 0 0 8px;
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .daftar-judul .label {
    margin: 0;
  }

  .alat {
    display: grid;
    gap: 12px;
    justify-items: start;
    width: 100%;
  }

  @media (min-width: 880px) {
    .alat {
      justify-items: end;
    }
  }

  .cari {
    display: grid;
    gap: 6px;
    width: 100%;
    max-width: 330px;
  }

  .cari-kotak {
    position: relative;
    display: block;
  }

  .cari-kotak svg {
    position: absolute;
    top: 50%;
    left: 12px;
    width: 15px;
    height: 15px;
    transform: translateY(-50%);
    color: var(--fg);
    pointer-events: none;
  }

  .cari input {
    width: 100%;
    min-height: 44px;
    padding: 9px 12px 9px 34px;
    border: 2px solid var(--fg);
    border-radius: 0;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.4;
  }

  .cari input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .cari input:focus-visible {
    outline: 3px solid var(--heat);
    outline-offset: 2px;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    max-width: 620px;
  }

  .filter-btn {
    min-height: 40px;
    padding: 5px 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    font-size: 0.66rem;
  }

  .filter-btn:hover {
    border-color: var(--fg);
    background: var(--surface-2);
    color: var(--fg);
  }

  .filter-btn[aria-pressed='true'] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .hasil {
    margin: 20px 0 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kartu-topik[hidden] {
    display: none;
  }

  .kosong {
    margin: 0;
    padding: 28px;
    border: 2px solid var(--fg);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .kategori-indeks {
    margin-top: clamp(46px, 7vw, 72px);
    padding-top: 22px;
    border-top: 4px solid var(--fg);
  }

  .kategori-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 10px;
  }

  .kategori-head h2 {
    margin: 0;
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .kategori-head .label {
    margin: 0;
  }

  .kategori-indeks ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .kategori-indeks ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }

  .kategori-indeks li {
    border-top: 1px solid var(--line);
    box-shadow: inset 6px 0 0 var(--aksen, var(--sea));
  }

  .kategori-indeks a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 3px 16px;
    padding: 14px 0 15px 16px;
    color: var(--fg);
    text-decoration: none;
    transition: background-color 120ms linear;
  }

  .kategori-indeks a:hover {
    background: var(--surface-2);
  }

  .kat-nama {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.55rem;
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .kat-jumlah {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .kat-desc {
    grid-column: 1 / -1;
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .kategori-indeks a:hover .kat-nama {
    color: var(--heat-ink);
  }

  @media (max-width: 560px) {
    .filter-btn {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strat a,
    .start,
    .start-arrow,
    .kategori-indeks a {
      transition: none;
    }

    .start:hover .start-arrow {
      transform: none;
    }
  }
</style>
