---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { getTopikTerbit, tanggalIndo, topikHref } from '../lib/topik';

const sumber = (await getCollection('sumber')).sort((a, b) =>
  a.data.penerbit.localeCompare(b.data.penerbit, 'id'),
);
const dataset = (await getCollection('dataset')).sort((a, b) =>
  a.data.nama.localeCompare(b.data.nama, 'id'),
);
const topik = await getTopikTerbit();

const pemakaian = new Map<string, typeof topik>();
for (const t of topik) {
  for (const id of [...t.data.sumber, ...t.data.dataset]) {
    if (!pemakaian.has(id)) pemakaian.set(id, []);
    pemakaian.get(id)!.push(t);
  }
}

const jenisLabel: Record<string, string> = {
  web: 'Laman web',
  jurnal: 'Jurnal',
  buku: 'Buku',
  dataset: 'Dataset',
  video: 'Video',
};
---

<Layout
  title="Sumber & lisensi"
  description="Semua sumber dan dataset yang dipakai Ruang Bumi, lengkap dengan lisensi dan tanggal akses."
>
  <div class="wrap halaman">
    <Breadcrumb items={[{ href: '/', label: 'Beranda' }, { label: 'Sumber & lisensi' }]} />

    <header class="kepala">
      <p class="label">{sumber.length} sumber · {dataset.length} dataset</p>
      <h1>Sumber &amp; lisensi</h1>
      <p class="intro">
        Halaman ini adalah daftar lengkap rujukan yang dipakai situs. Semua tautan dibuka di tab
        baru. Kalau sebuah tautan mati, itu bukan alasan untuk menghapus klaim: kami cari salinan
        resminya lebih dulu.
      </p>
    </header>

    <section class="bagian" aria-labelledby="daftar-sumber">
      <header class="bagian-head">
        <h2 id="daftar-sumber">Sumber</h2>
        <span class="bagian-jumlah">{sumber.length} entri</span>
      </header>
      <ul class="daftar">
        {
          sumber.map((s) => (
            <li>
              <div class="baris">
                <p class="judul">
                  <a href={s.data.url} rel="noopener noreferrer" target="_blank">
                    {s.data.judul}
                  </a>
                </p>
                <span class="chip">{jenisLabel[s.data.jenis] ?? s.data.jenis}</span>
              </div>
              <p class="meta">
                {s.data.penerbit} · diakses {tanggalIndo(s.data.diakses)} · lisensi {s.data.lisensi}
              </p>
              {s.data.catatan && <p class="catatan">{s.data.catatan}</p>}
              {
                (pemakaian.get(s.data.id) ?? []).length > 0 && (
                  <p class="dipakai">
                    Dipakai di:{' '}
                    {(pemakaian.get(s.data.id) ?? []).map((t, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={topikHref(t)}>{t.data.pertanyaan}</a>
                      </>
                    ))}
                  </p>
                )
              }
            </li>
          ))
        }
      </ul>
    </section>

    <section class="bagian blok" aria-labelledby="daftar-dataset">
      <header class="bagian-head">
        <h2 id="daftar-dataset">Dataset</h2>
        <span class="bagian-jumlah">{dataset.length} entri</span>
      </header>
      <ul class="daftar">
        {
          dataset.map((d) => (
            <li>
              <p class="judul">{d.data.nama}</p>
              <p class="meta">
                {d.data.lisensi} · diambil {tanggalIndo(d.data.diambil)} · asal {new URL(d.data.asal).hostname}
              </p>
              {d.data.catatan && <p class="catatan">{d.data.catatan}</p>}
              <p class="dipakai">
                Berkas: <code>{d.data.keluaran ?? '—'}</code>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="kebijakan" aria-labelledby="kebijakan">
      <h2 id="kebijakan">Kebijakan singkat</h2>
      <ul>
        <li>NASA, NOAA, dan USGS dipakai sebagai rujukan dan gambar; kredit tetap dicantumkan.</li>
        <li>BMKG hanya ditautkan sebagai rujukan, bukan sumber data otomatis.</li>
        <li>Data lempeng memakai PB2002 (Bird, 2003) lewat berkas turunan berlisensi ODbL.</li>
        <li>Teks ditulis ulang dengan kata sendiri; tidak ada kalimat yang disalin.</li>
        <li>Visual yang disederhanakan diberi label ilustrasi.</li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .halaman {
    padding-block: 20px clamp(36px, 5vw, 56px);
  }

  .kepala {
    position: relative;
    margin: 18px 0 clamp(26px, 3vw, 34px);
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .kepala::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 64px;
    height: 3px;
    background: var(--sea);
  }

  .kepala h1 {
    margin: 8px 0 10px;
    font-size: clamp(1.95rem, 4.3vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .intro {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .bagian-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .bagian-head::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 32px;
    height: 3px;
    background: var(--sea);
  }

  .bagian-head h2 {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .bagian-jumlah {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .bagian {
    max-width: 74ch;
  }

  .blok {
    margin-top: clamp(34px, 4vw, 46px);
  }

  .daftar {
    list-style: none;
    max-width: 74ch;
    padding: 0;
    margin: 4px 0 0;
    display: grid;
  }

  .daftar li {
    padding: 16px 0 18px;
    border-bottom: 1px solid var(--line);
  }

  .baris {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
  }

  .judul {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .judul a {
    color: var(--fg);
    text-decoration: none;
  }

  .judul a:hover {
    color: var(--sea);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .meta {
    margin: 5px 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .catatan {
    margin: 6px 0 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .dipakai {
    margin: 8px 0 0;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .dipakai a {
    color: var(--sea);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .kebijakan {
    max-width: 74ch;
    margin-top: clamp(36px, 5vw, 52px);
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .kebijakan h2 {
    margin: 0 0 10px;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .kebijakan ul {
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    display: grid;
    gap: 6px;
  }

  .kebijakan li::marker {
    color: var(--sea);
  }
</style>
