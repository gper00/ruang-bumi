---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import TopicCard from '../../components/topik/TopicCard.astro';
import { KATEGORI, getTopikTerbit } from '../../lib/topik';

export async function getStaticPaths() {
  return KATEGORI.map((k) => ({ params: { kategori: k.id } }));
}

const { kategori } = Astro.params;
const info = KATEGORI.find((k) => k.id === kategori);
if (!info) throw new Error(`Kategori tidak dikenal: ${kategori}`);

const semua = await getTopikTerbit();
const topik = semua.filter((t) => t.data.kategori === kategori);
const lain = KATEGORI.filter((k) => k.id !== kategori);
---

<Layout
  title={info.label}
  description={`${info.deskripsi} ${topik.length} topik dengan sumber terbuka.`}
>
  <div class="wrap halaman">
    <Breadcrumb
      items={[
        { href: '/', label: 'Beranda' },
        { href: '/topik/', label: 'Semua topik' },
        { label: info.label },
      ]}
    />

    <header class="kepala" data-kategori={kategori}>
      <p class="label">
        <span class="tanda" aria-hidden="true"></span> Kategori · {topik.length} topik
      </p>
      <h1>{info.label}</h1>
      <p class="intro">{info.deskripsi}</p>
    </header>

    {
      topik.length === 0 ? (
        <p class="kosong">Belum ada topik terbit di kategori ini. Sedang kami tulis.</p>
      ) : (
        <div class="grid-topik">
          {topik.map((entry) => (
            <TopicCard entry={entry} kategori={false} />
          ))}
        </div>
      )
    }

    <nav class="kategori-lain" aria-label="Kategori lain">
      <span class="label">Kategori lain</span>
      <ul>
        {
          lain.map((k) => (
            <li>
              <a href={`/kategori/${k.id}/`}>{k.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>

<style>
  .halaman {
    padding-block: 20px clamp(36px, 5vw, 56px);
  }

  .kepala {
    margin: 18px 0 clamp(26px, 3vw, 34px);
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .kepala::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 64px;
    height: 3px;
    background: var(--aksen, var(--sea));
  }

  .tanda {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--aksen, var(--sea));
    margin-right: 4px;
  }

  .kepala h1 {
    margin: 8px 0 10px;
    font-size: clamp(1.95rem, 4.3vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .intro {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .kosong {
    color: var(--muted);
    padding: 24px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }

  .kategori-lain {
    margin-top: clamp(36px, 5vw, 52px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .kategori-lain ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .kategori-lain a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .kategori-lain a:hover {
    color: var(--sea);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
