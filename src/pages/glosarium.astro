---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { glosarium, istilahSlug } from '../lib/glosarium';

const istilah = [...glosarium].sort((a, b) => a.istilah.localeCompare(b.istilah, 'id'));

const grup = new Map<string, typeof istilah>();
for (const item of istilah) {
  const huruf = item.istilah.charAt(0).toUpperCase();
  if (!grup.has(huruf)) grup.set(huruf, []);
  grup.get(huruf)!.push(item);
}
---

<Layout title="Glosarium" description="Istilah ilmu kebumian yang dipakai di Ruang Bumi, dijelaskan dengan bahasa sehari-hari.">
  <div class="wrap halaman">
    <Breadcrumb items={[{ href: '/', label: 'Beranda' }, { label: 'Glosarium' }]} />

    <header class="kepala">
      <p class="label">{istilah.length} istilah</p>
      <h1>Glosarium</h1>
      <p class="intro">
        Istilah teknis dijelaskan sekali, lalu dipakai konsisten. Tanda bintang kecil di dalam
        artikel menunjuk ke halaman ini.
      </p>
    </header>

    <nav class="huruf" aria-label="Lompat ke huruf">
      {[...grup.keys()].map((huruf) => <a href={`#${huruf}`}>{huruf}</a>)}
    </nav>

    {
      [...grup.entries()].map(([huruf, isi]) => (
        <section class="grup" aria-labelledby={`huruf-${huruf}`}>
          <h2 id={`huruf-${huruf}`}>
            <span class="huruf-besar">{huruf}</span>
            <span class="grup-garis" aria-hidden="true"></span>
            <span class="grup-jumlah">{isi.length} istilah</span>
          </h2>
          <dl>
            {isi.map((item) => (
              <div class="istilah" id={istilahSlug(item.istilah)}>
                <dt>{item.istilah}</dt>
                <dd>{item.definisi}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .halaman {
    padding-block: 20px clamp(36px, 5vw, 56px);
  }

  .kepala {
    margin: 18px 0 22px;
  }

  .kepala h1 {
    margin: 8px 0 10px;
    font-size: clamp(1.95rem, 4.3vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .intro {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .huruf {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: clamp(26px, 3vw, 34px);
    padding-block: 14px 16px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .huruf a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 29px;
    height: 29px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .huruf a:hover {
    border-color: var(--sea);
    background: var(--sea-soft);
    color: var(--fg);
  }

  .grup {
    margin-top: clamp(26px, 3vw, 34px);
  }

  .grup h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 14px;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    scroll-margin-top: 88px;
  }

  .huruf-besar {
    line-height: 1;
  }

  .grup-garis {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .grup-jumlah {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    white-space: nowrap;
  }

  dl {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  @media (min-width: 760px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 40px;
    }
  }

  .istilah {
    scroll-margin-top: 90px;
  }

  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 3px 0 0;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--muted);
    text-wrap: pretty;
  }

  .istilah:target dt {
    color: var(--sea);
  }
</style>
