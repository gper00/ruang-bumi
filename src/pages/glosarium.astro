---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { glosarium, istilahSlug } from '../lib/glosarium';

const istilah = [...glosarium].sort((a, b) => a.istilah.localeCompare(b.istilah, 'id'));

const grup = new Map<string, typeof istilah>();
for (const item of istilah) {
  const huruf = item.istilah.charAt(0).toUpperCase();
  if (!grup.has(huruf)) grup.set(huruf, []);
  grup.get(huruf)!.push(item);
}
---

<Layout title="Glosarium" description="Istilah ilmu kebumian yang dipakai di Ruang Bumi, dijelaskan dengan bahasa sehari-hari.">
  <div class="wrap halaman">
    <Breadcrumb items={[{ href: '/', label: 'Beranda' }, { label: 'Glosarium' }]} />

    <header class="kepala">
      <p class="label">{istilah.length} istilah</p>
      <h1>Glosarium</h1>
      <p class="intro">
        Istilah teknis dijelaskan sekali, lalu dipakai konsisten. Tanda bintang kecil di dalam
        artikel menunjuk ke halaman ini.
      </p>
    </header>

    <nav class="huruf" aria-label="Lompat ke huruf">
      {[...grup.keys()].map((huruf) => <a href={`#${huruf}`}>{huruf}</a>)}
    </nav>

    {
      [...grup.entries()].map(([huruf, isi]) => (
        <section class="grup" aria-labelledby={`huruf-${huruf}`}>
          <h2 id={`huruf-${huruf}`}>
            <span class="huruf-besar">{huruf}</span>
            <span class="grup-garis" aria-hidden="true"></span>
            <span class="grup-jumlah">{isi.length} istilah</span>
          </h2>
          <dl>
            {isi.map((item) => (
              <div class="istilah" id={istilahSlug(item.istilah)}>
                <dt>{item.istilah}</dt>
                <dd>{item.definisi}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .halaman {
    padding-block: 20px clamp(36px, 5vw, 56px);
  }

  .kepala {
    margin: 22px 0 26px;
    padding-bottom: 24px;
    border-bottom: 3px solid var(--fg);
  }

  .kepala h1 {
    margin: 12px 0 14px;
    font-size: clamp(3rem, 6.5vw, 5.2rem);
    font-weight: 900;
    line-height: 0.84;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .intro {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .huruf {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: clamp(28px, 4vw, 38px);
    padding-block: 14px 16px;
    border-top: 2px solid var(--fg);
    border-bottom: 2px solid var(--fg);
  }

  .huruf a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.76rem;
    transition:
      border-color 120ms linear,
      color 120ms linear,
      background-color 120ms linear;
  }

  .huruf a:hover {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 560px) {
    .huruf a {
      width: 44px;
      height: 44px;
    }
  }

  .grup {
    margin-top: clamp(26px, 3vw, 34px);
  }

  .grup h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 16px;
    font-size: 2rem;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    scroll-margin-top: 112px;
  }

  .huruf-besar {
    line-height: 1;
  }

  .grup-garis {
    flex: 1;
    height: 3px;
    background: var(--fg);
  }

  .grup-jumlah {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    white-space: nowrap;
  }

  dl {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  @media (min-width: 760px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 40px;
    }
  }

  .istilah {
    scroll-margin-top: 90px;
  }

  dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 3px 0 0;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--muted);
    text-wrap: pretty;
  }

  .istilah:target dt {
    color: var(--heat-ink);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
</style>
