---
import { kategoriLabel, topikHref, type Topik } from '../../lib/topik';

interface Props {
  entry: Topik;
  kategori?: boolean;
}

const { entry, kategori = true } = Astro.props;
---

<article
  class="kartu-topik"
  data-kategori={entry.data.kategori}
  data-cari={`${entry.data.pertanyaan} ${entry.data.jawabanSingkat} ${kategoriLabel(entry.data.kategori)}`.toLowerCase()}
>
  <p class="kartu-label">
    {kategori && <span class="kartu-kat">{kategoriLabel(entry.data.kategori)}</span>}
    <span>{entry.data.menit} menit</span>
  </p>
  <h3><a href={topikHref(entry)}>{entry.data.pertanyaan}</a></h3>
  <p class="kartu-jawab">{entry.data.jawabanSingkat}</p>
  <span class="kartu-tanda" aria-hidden="true">→</span>
</article>

<style>
  .kartu-topik {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .kartu-topik::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--aksen, var(--line-strong));
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .kartu-topik:hover,
  .kartu-topik:focus-within {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.06);
  }

  .kartu-topik:hover::before,
  .kartu-topik:focus-within::before {
    opacity: 1;
  }

  .kartu-label {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }

  .kartu-kat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg);
  }

  .kartu-kat::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--aksen, var(--sea));
  }

  .kartu-label > span + span::before {
    content: '·';
    margin-right: 10px;
  }

  h3 {
    margin: 0;
    font-size: 1.14rem;
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
    padding-right: 22px;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  /* Klik di mana saja pada kartu: tarik seluruh area ke tautan h3. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    color: var(--sea);
  }

  h3 a:focus-visible {
    outline: none;
  }

  .kartu-topik:focus-within {
    outline: 2px solid var(--sea);
    outline-offset: 2px;
  }

  .kartu-jawab {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .kartu-tanda {
    position: absolute;
    right: 18px;
    bottom: 16px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--line-strong);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }

  .kartu-topik:hover .kartu-tanda,
  .kartu-topik:focus-within .kartu-tanda {
    color: var(--aksen, var(--sea));
    transform: translateX(3px);
  }
</style>
