---
import { kategoriLabel, topikHref, type Topik } from '../../lib/topik';

interface Props {
  entry: Topik;
  kategori?: boolean;
}

const { entry, kategori = true } = Astro.props;
const jumlahSumber = entry.data.sumber.length;
---

<article
  class="kartu-topik"
  data-kategori={entry.data.kategori}
  data-cari={`${entry.data.pertanyaan} ${entry.data.jawabanSingkat} ${kategoriLabel(entry.data.kategori)}`.toLowerCase()}
>
  {kategori && (
    <p class="kartu-label">
      <span class="kartu-kat">{kategoriLabel(entry.data.kategori)}</span>
    </p>
  )}
  <h3><a href={topikHref(entry)}>{entry.data.pertanyaan}</a></h3>
  <p class="kartu-jawab">{entry.data.jawabanSingkat}</p>
  <p class="kartu-kaki">
    <span>{entry.data.menit} menit · {jumlahSumber} sumber</span>
    <span class="kartu-tanda" aria-hidden="true">→</span>
  </p>
</article>

<style>
  .kartu-topik {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .kartu-topik:hover,
  .kartu-topik:focus-within {
    border-color: var(--aksen, var(--sea));
    transform: translateY(-1px);
  }

  .kartu-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kartu-kat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--fg);
  }

  .kartu-kat::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--aksen, var(--sea));
  }

  h3 {
    margin: 2px 0 0;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  /* Klik di mana saja pada kartu: tarik seluruh area ke tautan h3. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .kartu-topik:focus-within {
    outline: 2px solid var(--sea);
    outline-offset: 2px;
  }

  .kartu-jawab {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--muted);
    text-wrap: pretty;
  }

  .kartu-kaki {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .kartu-tanda {
    font-size: 0.9rem;
    color: var(--line-strong);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .kartu-topik:hover .kartu-tanda,
  .kartu-topik:focus-within .kartu-tanda {
    color: var(--aksen, var(--sea));
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .kartu-topik,
    .kartu-tanda {
      transition: none;
    }

    .kartu-topik:hover,
    .kartu-topik:focus-within {
      transform: none;
    }

    .kartu-topik:hover .kartu-tanda,
    .kartu-topik:focus-within .kartu-tanda {
      transform: none;
    }
  }
</style>
