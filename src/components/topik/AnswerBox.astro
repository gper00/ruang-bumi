---
interface Props {
  ringkas?: string;
}

const { ringkas } = Astro.props;
---

<section class="answer" aria-label="Jawaban singkat">
  <p class="answer-label">Jawaban singkat</p>
  {ringkas ? <p class="answer-text">{ringkas}</p> : <slot />}
</section>

<style>
  .answer {
    position: relative;
    margin: 1.5rem 0 2rem;
    padding: 20px 24px 22px;
  }

  .answer-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sea);
    margin: 0 0 8px;
  }

  .answer-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .answer-text {
    margin: 0;
    font-size: 1.14rem;
    line-height: 1.65;
    font-weight: 500;
    text-wrap: pretty;
  }
</style>
