---
interface Props {
  ringkas?: string;
}

const { ringkas } = Astro.props;
---

<section class="answer" aria-label="Jawaban singkat">
  <p class="answer-label">Jawaban singkat</p>
  {ringkas ? <p class="answer-text">{ringkas}</p> : <slot />}
</section>

<style>
  .answer {
    position: relative;
    margin: 1.9rem 0 2.4rem;
    padding: 24px 26px 26px;
    border-radius: 0;
  }

  .answer-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--heat-on-ink);
    margin: 0 0 12px;
  }

  .answer-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #3f4238;
  }

  .answer-text {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: clamp(1.04rem, 1rem + 0.2vw, 1.12rem);
    line-height: 1.62;
    font-weight: 450;
    color: var(--paper);
    text-wrap: pretty;
  }
</style>
