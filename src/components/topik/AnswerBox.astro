---
interface Props {
  ringkas?: string;
}

const { ringkas } = Astro.props;
---

<section class="answer" aria-label="Jawaban singkat">
  <p class="answer-label">Jawaban singkat</p>
  {ringkas ? <p class="answer-text">{ringkas}</p> : <slot />}
</section>

<style>
  .answer {
    position: relative;
    margin: 1.75rem 0 2.25rem;
    padding: 20px 24px 21px;
    border-radius: 8px;
  }

  .answer-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sea);
    margin: 0 0 9px;
  }

  .answer-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .answer-text {
    margin: 0;
    max-width: 58ch;
    font-size: clamp(1.18rem, 1.1rem + 0.3vw, 1.28rem);
    line-height: 1.6;
    font-weight: 450;
    text-wrap: pretty;
  }
</style>
