---
/**
 * Penampang melintang zona subduksi. Statis (tanpa JS): hanya ilustrasi
 * skematis — ketebalan, sudut, dan kedalaman tidak sesuai skala nyata.
 */
---

<svg
  class="subd"
  viewBox="0 0 640 340"
  role="img"
  aria-labelledby="subd-title subd-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="subd-title">Penampang melintang zona subduksi</title>
  <desc id="subd-desc">
    Lempeng samudra bergerak ke kanan di bawah laut, membentuk parit, lalu menunjam ke bawah
    lempeng benua. Di sepanjang bidang kontaknya terdapat pusat gempa yang makin dalam ke arah
    benua. Batuan yang meleleh naik sebagai magma hingga ke gunung api di permukaan benua.
  </desc>

  <!-- Mantel (latar) -->
  <rect x="0" y="0" width="640" height="340" fill="var(--mantle)" />
  <!-- Langit -->
  <rect x="0" y="0" width="640" height="90" fill="var(--sea-soft)" />

  <!-- Lempeng samudra yang menunjam -->
  <path
    d="M0 178 L300 178 L482 340"
    fill="none"
    stroke="var(--coast)"
    stroke-width="36"
    stroke-linejoin="round"
    stroke-linecap="round"
  />

  <!-- Air laut -->
  <polygon points="30,90 399,90 390,240 300,160 30,160" fill="var(--ocean)" stroke="var(--coast)" stroke-width="1.5" />
  <!-- Muka laut -->
  <line x1="30" y1="90" x2="399" y2="90" stroke="var(--sea)" stroke-width="2" />

  <!-- Lempeng benua -->
  <polygon
    points="400,70 640,70 640,340 503,340 390,240"
    fill="var(--land)"
    stroke="var(--coast)"
    stroke-width="1.5"
  />

  <!-- Magma: dari bidang menunjam ke kamar magma -->
  <path
    d="M452 294 C472 262 466 220 478 188"
    fill="none"
    stroke="var(--heat)"
    stroke-width="9"
    stroke-linecap="round"
    opacity="0.9"
  />
  <ellipse cx="480" cy="168" rx="40" ry="16" fill="var(--heat)" opacity="0.9" />
  <path
    d="M482 154 C486 130 490 110 490 76"
    fill="none"
    stroke="var(--heat)"
    stroke-width="9"
    stroke-linecap="round"
    opacity="0.9"
  />

  <!-- Gunung api -->
  <polygon points="445,70 490,30 535,70" fill="var(--sand)" stroke="var(--heat)" stroke-width="1.5" />

  <!-- Pusat gempa sepanjang bidang menunjam -->
  <g class="fokus">
    <circle cx="340" cy="205" r="5.5"></circle>
    <circle cx="380" cy="240" r="5.5"></circle>
    <circle cx="420" cy="276" r="5.5"></circle>
    <circle cx="460" cy="311" r="5.5"></circle>
  </g>

  <!-- Arah gerak lempeng samudra -->
  <g class="gerak">
    <line x1="170" y1="178" x2="252" y2="178"></line>
    <polygon points="252,171 266,178 252,185"></polygon>
  </g>

  <!-- Label -->
  <text class="lbl" x="170" y="128">Laut</text>
  <text class="lbl" x="46" y="183">Lempeng samudra</text>
  <text class="lbl" x="545" y="102">Lempeng benua</text>
  <text class="lbl" x="55" y="255">Mantel</text>
  <text class="lbl" x="490" y="22" text-anchor="middle">Gunung api</text>

  <!-- Parit laut + penunjuk -->
  <text class="lbl" x="330" y="64">Parit laut</text>
  <line class="penunjuk" x1="374" y1="72" x2="388" y2="233"></line>
  <circle cx="390" cy="240" r="3.5" class="penunjuk-titik"></circle>

  <!-- Magma + penunjuk -->
  <text class="lbl" x="552" y="178">Magma</text>
  <line class="penunjuk-heat" x1="549" y1="174" x2="522" y2="170"></line>

  <!-- Pusat gempa + penunjuk -->
  <text class="lbl" x="110" y="320">Pusat gempa</text>
  <line class="penunjuk" x1="218" y1="314" x2="332" y2="209"></line>
</svg>

<style>
  .subd {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--mantle);
  }

  .lbl {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--fg);
    letter-spacing: 0.02em;
  }

  .fokus circle {
    fill: var(--fg);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .gerak line {
    stroke: var(--fg);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .gerak polygon {
    fill: var(--fg);
    opacity: 0.75;
  }

  .penunjuk {
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .penunjuk-titik {
    fill: var(--muted);
  }

  .penunjuk-heat {
    stroke: var(--heat);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
</style>
