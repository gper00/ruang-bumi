---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const nav = [
  { href: '/topik/', label: 'Semua topik' },
  { href: '/glosarium/', label: 'Glosarium' },
  { href: '/sumber/', label: 'Sumber' },
  { href: '/tentang/', label: 'Tentang' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">Ruang Bumi</span>
        <span class="brand-sub">ilmu kebumian, satu pertanyaan sekali jalan</span>
      </span>
    </a>

    <div class="header-nav">
      <nav aria-label="Navigasi utama">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 10px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg);
  }

  .brand-mark {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sea);
    box-shadow: inset -5px -4px 0 0 var(--sea-soft);
  }

  .brand-text {
    display: grid;
    line-height: 1.15;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.015em;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8rem;
  }

  nav a {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    padding-block: 5px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  nav a:hover {
    color: var(--fg);
    border-bottom-color: var(--line-strong);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
    border-bottom-color: var(--sea);
  }

  @media (max-width: 640px) {
    .brand-sub {
      display: none;
    }

    /* Keep the four links on one row next to the theme toggle. */
    .header-nav {
      gap: 12px;
    }

    nav ul {
      gap: 2px 12px;
    }
  }
</style>
