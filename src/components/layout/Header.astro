---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const nav = [
  { href: '/topik/', label: 'Semua topik' },
  { href: '/glosarium/', label: 'Glosarium' },
  { href: '/sumber/', label: 'Sumber' },
  { href: '/tentang/', label: 'Tentang' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">Ruang Bumi</span>
        <span class="brand-sub">lembar lapangan ilmu kebumian</span>
      </span>
    </a>

    <div class="header-nav">
      <nav aria-label="Navigasi utama">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 4px solid var(--heat);
    background: var(--ink);
    color: var(--paper);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 28px;
    min-height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--paper);
    text-decoration: none;
  }

  /* Sample core: four strata in one narrow column. */
  .brand-mark {
    width: 18px;
    height: 28px;
    background: linear-gradient(
      to bottom,
      var(--acc-atmosfer) 0 22%,
      var(--acc-laut) 22% 46%,
      var(--acc-daratan) 46% 70%,
      var(--acc-ekologi) 70% 100%
    );
    box-shadow: inset 0 0 0 1px var(--paper);
  }

  .brand-text {
    display: grid;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.45rem;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .brand-sub {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 6px 8px;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      background-color 120ms linear,
      color 120ms linear;
  }

  nav a:hover {
    background: color-mix(in srgb, var(--paper) 12%, transparent);
    color: var(--paper);
  }

  nav a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
  }

  .header-nav :global(.theme-toggle) {
    border-color: #4b4e43;
    background: transparent;
    color: var(--paper);
  }

  .header-nav :global(.theme-toggle:hover) {
    border-color: var(--paper);
    background: var(--paper);
    color: var(--ink);
  }

  .header-nav :global(.theme-toggle .teks) {
    color: inherit;
  }

  @media (max-width: 760px) {
    .header-inner {
      gap: 0;
      padding-top: 10px;
    }

    .brand {
      padding-bottom: 8px;
    }

    .header-nav {
      justify-content: space-between;
      width: 100%;
      padding-block: 5px 7px;
      border-top: 1px solid #34372d;
    }

    nav ul {
      gap: 0;
    }

    nav a {
      min-height: 36px;
      padding-inline: 6px;
    }
  }

  @media (max-width: 420px) {
    .brand-sub {
      display: none;
    }

    nav ul {
      font-size: 0.66rem;
    }

    nav a {
      padding-inline: 4px;
    }
  }
</style>
