---
const tahun = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="label">Kolofon</p>
      <p class="footer-name">Ruang Bumi<span aria-hidden="true">.</span></p>
      <p class="footer-desc">
        Belajar ilmu kebumian lewat pertanyaan, visual interaktif, dan sumber yang bisa ditelusuri.
      </p>
    </div>

    <nav aria-label="Navigasi kaki halaman">
      <p class="label">Jelajahi</p>
      <ul>
        <li><a href="/topik/">Semua topik</a></li>
        <li><a href="/kategori/atmosfer/">Kategori</a></li>
        <li><a href="/glosarium/">Glosarium</a></li>
        <li><a href="/sumber/">Sumber &amp; lisensi</a></li>
        <li><a href="/tentang/">Tentang</a></li>
      </ul>
    </nav>

    <div class="footer-legal">
      <p class="label">Lisensi</p>
      <p>© {tahun} Ruang Bumi. Teks CC BY 4.0, kode MIT.</p>
      <p>Peta lempeng: PB2002 (Bird, 2003), ODbL.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    border-top: 4px solid var(--heat);
    background: var(--ink);
    color: var(--paper);
  }

  .footer-inner {
    display: grid;
    gap: 30px;
    padding-block: 38px 46px;
    font-size: 0.86rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      column-gap: 40px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 980px) {
    .footer-inner {
      grid-template-columns: 1.55fr 0.7fr 0.9fr;
      gap: 48px;
    }

    .footer-brand {
      grid-column: auto;
    }
  }

  .label {
    margin: 0;
    color: var(--ink-muted);
  }

  .footer-name {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.72;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .footer-name span {
    color: var(--heat-on-ink);
  }

  .footer-desc,
  .footer-legal p:not(.label) {
    margin: 14px 0 0;
    max-width: 44ch;
    color: #d8d3c5;
    line-height: 1.6;
  }

  .footer-legal p:not(.label) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.84rem;
  }

  a {
    color: #e4dfd1;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--heat-on-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>
