---
interface Props {
  label?: string;
}

const { label = 'Catatan' } = Astro.props;
---

<aside class="data-note">
  <span class="data-label">{label}</span>
  <div class="data-body"><slot /></div>
</aside>

<style>
  .data-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    margin: 1.8rem 0;
    padding: 14px 16px;
    border: 2px solid var(--fg);
    border-left: 8px solid var(--heat);
    border-radius: 0;
    background: var(--surface-2);
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .data-label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--heat-ink);
    padding-top: 3px;
    white-space: nowrap;
  }

  .data-body :global(p) {
    margin: 0;
  }
</style>
