---
interface Props {
  label?: string;
}

const { label = 'Catatan' } = Astro.props;
---

<aside class="data-note">
  <span class="data-label">{label}</span>
  <div class="data-body"><slot /></div>
</aside>

<style>
  .data-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    margin: 1.6rem 0;
    padding: 13px 16px;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .data-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--heat-ink);
    padding-top: 2px;
    white-space: nowrap;
  }

  .data-body :global(p) {
    margin: 0;
  }
</style>
