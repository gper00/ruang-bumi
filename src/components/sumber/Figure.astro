---
import { datasetById } from '../../lib/topik';
import { getEntry } from 'astro:content';

interface Props {
  source?: string;
  dataset?: string | string[];
  caption: string;
}

const { source, dataset, caption } = Astro.props;

const sumber = source ? await getEntry('sumber', source) : undefined;
const datasetIds = dataset ? (Array.isArray(dataset) ? dataset : [dataset]) : [];
const datasets = [];
for (const id of datasetIds) {
  const entry = await datasetById(id);
  if (entry) datasets.push({ id, data: entry.data });
}
---

<figure class="figure">
  <div class="figure-body">
    <slot />
  </div>
  <figcaption class="figure-caption">
    <span>{caption}</span>
    <span class="figure-source">
      {
        sumber && (
          <>
            Sumber: <a href={sumber.data.url} rel="noopener noreferrer" target="_blank">
              {sumber.data.penerbit} — {sumber.data.judul}
            </a>
          </>
        )
      }
      {
        datasets.map((d, i) => (
          <>
            {(sumber || i > 0) && ' · '}
            Data: <a href={`#dataset-${d.id}`}>{d.data.nama}</a> ({d.data.lisensi})
          </>
        ))
      }
      {!sumber && datasets.length === 0 && <span class="missing">Sumber belum ditulis.</span>}
    </span>
  </figcaption>
</figure>

<style>
  /* Figure diperlakukan seperti pelat lapangan: bingkai tebal, caption
     berwarna tinta, tanpa radius agar tidak terbaca sebagai kartu UI. */
  .figure {
    margin: 2.6rem 0;
    border: 2px solid var(--fg);
    border-radius: 0;
    background: var(--surface);
    overflow: hidden;
  }

  .figure-body {
    padding: 0;
    background: var(--surface);
  }

  .figure-caption {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 14px 16px 16px;
    border-top: 2px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .figure-source {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--bg) 76%, var(--fg));
  }

  .figure-source a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .missing {
    font-weight: 700;
    color: inherit;
  }
</style>
