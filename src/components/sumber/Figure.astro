---
import { datasetById } from '../../lib/topik';
import { getEntry } from 'astro:content';

interface Props {
  source?: string;
  dataset?: string | string[];
  caption: string;
}

const { source, dataset, caption } = Astro.props;

const sumber = source ? await getEntry('sumber', source) : undefined;
const datasetIds = dataset ? (Array.isArray(dataset) ? dataset : [dataset]) : [];
const datasets = [];
for (const id of datasetIds) {
  const entry = await datasetById(id);
  if (entry) datasets.push({ id, data: entry.data });
}
---

<figure class="figure">
  <div class="figure-body">
    <slot />
  </div>
  <figcaption class="figure-caption">
    <span>{caption}</span>
    <span class="figure-source">
      {
        sumber && (
          <>
            Sumber: <a href={sumber.data.url} rel="noopener noreferrer" target="_blank">
              {sumber.data.penerbit} — {sumber.data.judul}
            </a>
          </>
        )
      }
      {
        datasets.map((d, i) => (
          <>
            {(sumber || i > 0) && ' · '}
            Data: <a href={`#dataset-${d.id}`}>{d.data.nama}</a> ({d.data.lisensi})
          </>
        ))
      }
      {!sumber && datasets.length === 0 && <span class="missing">Sumber belum ditulis.</span>}
    </span>
  </figcaption>
</figure>

<style>
  .figure {
    margin: 2.4rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .figure-body {
    padding: 12px;
    background: var(--surface-2);
  }

  .figure-caption {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 13px 16px 15px;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .figure-source {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .figure-source a {
    color: var(--sea);
  }

  .missing {
    color: var(--bad);
  }
</style>
